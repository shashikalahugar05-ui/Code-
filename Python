import matplotlib
matplotlib.use('Agg') # Mobile fix
import matplotlib.pyplot as plt
import pandas as pd

# ===== INPUT - Load from CSV or use sample data =====
try:
    df = pd.read_csv('financial_data.csv')
    dates = df['Date'].tolist()
    revenue = df['Revenue'].tolist()
    cogs = df['COGS'].tolist()
    net_income = df['Net_Income'].tolist()
except:
    # Fallback sample data if CSV not found - For mobile
    dates = ['2023-01','2023-04','2023-07','2023-10','2024-01','2024-04','2024-07','2024-10','2025-01','2025-04','2025-07','2025-10']
    revenue = [521000,540000,595000,565000,555000,610000,600000,678000,650000,675000,753000,693000]
    cogs = [265710,275400,303450,288150,283050,311100,306000,345780,331500,344250,384030,353430]
    net_income = [97609,102672,124836,109332,110124,128088,123120,152798,140040,150300,179978,154490]

# ===== MOBILE RESPONSIVE DASHBOARD =====
fig = plt.figure(figsize=(10, 12)) # Mobile size - vertical
fig.patch.set_facecolor('#f0f2f5')
plt.suptitle('Financial Health Dashboard - SME\nPower BI Internship - CodeAlpha', fontsize=14, fontweight='bold', y=0.98)

# Grid 3x2 for mobile
gs = fig.add_gridspec(4, 2, hspace=0.6, wspace=0.4)

# KPI Row
ax_kpi = fig.add_subplot(gs[0, :])
ax_kpi.axis('off')
ax_kpi.text(0.05, 0.5, "Revenue: ₹4.20M (+8.2%) | COGS: ₹2.18M (52%) | Net: ₹903K (21.5% Margin)", 
            fontsize=10, fontweight='bold', bbox=dict(facecolor='white', edgecolor='#0078D4', boxstyle='round,pad=0.5'))

# 1. Income Statement
ax1 = fig.add_subplot(gs[1, 0])
ax1.plot(dates, revenue, label='Revenue', color='#0078D4', linewidth=2)
ax1.plot(dates, cogs, label='COGS', color='#D83B01', linestyle='--')
ax1.plot(dates, net_income, label='Net Income', color='#107C10', linewidth=2)
ax1.set_title('Income Statement', fontsize=10, fontweight='bold')
ax1.tick_params(axis='x', rotation=90, labelsize=7)
ax1.legend(fontsize=6)
ax1.grid(True, alpha=0.3)

# 2. Profitability
ax2 = fig.add_subplot(gs[1, 1])
gross_margin = [(r-c)/r*100 for r,c in zip(revenue, cogs)]
net_margin = [n/r*100 for n,r in zip(net_income, revenue)]
ax2.plot(dates, gross_margin, label='Gross Margin', color='#0078D4')
ax2.plot(dates, net_margin, label='Net Margin', color='#107C10')
ax2.set_title('Profitability Margin %', fontsize=10, fontweight='bold')
ax2.tick_params(axis='x', rotation=90, labelsize=7)
ax2.legend(fontsize=6)
ax2.grid(True, alpha=0.3)

# 3. Balance Sheet
ax3 = fig.add_subplot(gs[2, 0])
ax3.pie([27.5, 9.9, 11.0, 51.6], labels=['Cash','Recv','Inv','Fixed'], autopct='%1.1f%%', textprops={'fontsize': 7})
ax3.set_title('Balance Sheet - Assets', fontsize=10, fontweight='bold')

# 4. Cash Flow
ax4 = fig.add_subplot(gs[2, 1])
ax4.bar(['Op CF','Inv CF','Fin CF','Net CF'], [160000,-28000,-14000,118000], color=['#107C10','#D83B01','#D83B01','#107C10'])
ax4.set_title('Cash Flow', fontsize=10, fontweight='bold')
ax4.tick_params(axis='x', labelsize=7)

# 5. Forecasting
ax5 = fig.add_subplot(gs[3, :])
future = ['2026-01','2026-03','2026-05','2026-07']
forecast = [700000, 716000, 732000, 748000]
ax5.plot(dates[-6:], revenue[-6:], label='Actual', color='#0078D4', linewidth=2)
ax5.plot(future, forecast, label='Forecast', color='#D83B01', linestyle='--', linewidth=2)
ax5.fill_between(future, [f*0.92 for f in forecast], [f*1.08 for f in forecast], color='#D83B01', alpha=0.15)
ax5.set_title('Budgeting & Forecasting Next 6 Months (+12%)', fontsize=10, fontweight='bold')
ax5.legend(fontsize=7)
ax5.grid(True, alpha=0.3)
ax5.tick_params(axis='x', rotation=45, labelsize=7)

# Insights
fig.text(0.5, 0.01, "INSIGHTS: Healthy 21.5% Margin | Cash Positive ₹1.18L/mo | COGS 52% Reduce to 48%", 
         ha='center', fontsize=8, bbox=dict(facecolor="#FFF4CE", edgecolor="#FFC000", boxstyle="round,pad=0.3"))

